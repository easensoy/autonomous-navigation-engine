<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ane_sim</name>
  <version>0.1.0</version>
  <description>Gazebo Harmonic warehouse, launch files, RViz2 view, scenarios and trial scripts for the Autonomous Navigation Engine ROS 2 integration. The world and the planning roadmap are both generated from maps/warehouse_layout.txt.</description>
  <maintainer email="easensoy@users.noreply.github.com">easensoy</maintainer>
  <!-- The repository has no LICENSE file; until one is added, the default (all rights reserved) applies. -->
  <license>All rights reserved</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ane_description</exec_depend>
  <exec_depend>ane_interfaces</exec_depend>
  <exec_depend>ane_navigation</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rosbag2</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
