<?xml version="1.0"?>
<!--
  ane_amr: compact differential-drive robot for the Autonomous Navigation Engine simulation.

  Frames (REP 103, REP 105): x forward, y left, z up.
    base_footprint  root; ground projection of the rotation axis (midpoint of the wheel axle)
    base_link       on the wheel axle, wheel_radius above base_footprint
    left/right_wheel_link   continuous joints about +y; positive rotation drives the robot forward
    front/rear_caster_link  fixed spheres; their centres sit 0.5 mm higher than a ground contact
                            would need, so the two drive wheels carry the weight
    lidar_link      the 2-D lidar; scan plane 0.18 m above the floor

  The navigator's footprint contract (0.40 m x 0.37 m, circumscribed radius 0.272 m) is the chassis
  length and the width across the outer wheel faces (wheel_separation + wheel_width).
  Pass sim:=false to leave out the Gazebo plugins and sensor.
-->
<robot name="ane_amr" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="sim" default="true"/>
  <xacro:include filename="$(find ane_description)/urdf/inertia.xacro"/>

  <xacro:property name="chassis_length" value="0.40"/>
  <xacro:property name="chassis_width" value="0.30"/>
  <xacro:property name="chassis_height" value="0.12"/>
  <xacro:property name="chassis_bottom" value="0.04"/>
  <xacro:property name="chassis_mass" value="8.0"/>
  <xacro:property name="wheel_radius" value="0.06"/>
  <xacro:property name="wheel_width" value="0.03"/>
  <xacro:property name="wheel_separation" value="0.34"/>
  <xacro:property name="wheel_mass" value="0.4"/>
  <xacro:property name="caster_radius" value="0.0195"/>
  <xacro:property name="caster_offset" value="0.15"/>
  <xacro:property name="caster_mass" value="0.1"/>
  <xacro:property name="lidar_radius" value="0.035"/>
  <xacro:property name="lidar_height" value="0.04"/>
  <xacro:property name="lidar_mass" value="0.15"/>
  <xacro:property name="chassis_z" value="${chassis_bottom + chassis_height / 2 - wheel_radius}"/>

  <material name="body"><color rgba="0.85 0.45 0.10 1"/></material>
  <material name="tyre"><color rgba="0.10 0.10 0.10 1"/></material>
  <material name="sensor"><color rgba="0.15 0.15 0.18 1"/></material>
  <material name="caster"><color rgba="0.55 0.55 0.58 1"/></material>

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_z}" rpy="0 0 0"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
      <material name="body"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_z}" rpy="0 0 0"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
    </collision>
    <xacro:box_inertia m="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}" origin_z="${chassis_z}"/>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="wheel" params="side y">
    <link name="${side}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="tyre"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:wheel_inertia m="${wheel_mass}" r="${wheel_radius}" w="${wheel_width}"/>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="0 ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>
  <xacro:wheel side="left" y="${wheel_separation / 2}"/>
  <xacro:wheel side="right" y="${-wheel_separation / 2}"/>

  <xacro:macro name="caster" params="name x">
    <link name="${name}_caster_link">
      <visual>
        <geometry><sphere radius="${caster_radius}"/></geometry>
        <material name="caster"/>
      </visual>
      <collision>
        <geometry><sphere radius="${caster_radius}"/></geometry>
      </collision>
      <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}"/>
    </link>
    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_caster_link"/>
      <origin xyz="${x} 0 ${caster_radius + 0.0005 - wheel_radius}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
  <xacro:caster name="front" x="${caster_offset}"/>
  <xacro:caster name="rear" x="${-caster_offset}"/>

  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
      <material name="sensor"/>
    </visual>
    <collision>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
    </collision>
    <xacro:cylinder_inertia m="${lidar_mass}" r="${lidar_radius}" h="${lidar_height}"/>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${chassis_bottom + chassis_height + lidar_height / 2 - wheel_radius}" rpy="0 0 0"/>
  </joint>

  <xacro:if value="$(arg sim)">
    <xacro:include filename="$(find ane_description)/urdf/ane_amr.gazebo.xacro"/>
  </xacro:if>
</robot>
