<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ane_description</name>
  <version>0.1.0</version>
  <description>URDF/Xacro model of ane_amr, the compact differential-drive robot of the Autonomous Navigation Engine simulation, with its Gazebo Harmonic plugins and lidar.</description>
  <maintainer email="easensoy@users.noreply.github.com">easensoy</maintainer>
  <!-- The repository has no LICENSE file; until one is added, the default (all rights reserved) applies. -->
  <license>All rights reserved</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <test_depend>liburdfdom-tools</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
